<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Required to create and bind a VPN interface via VpnService -->
    <uses-permission android:name="android.permission.BIND_VPN_SERVICE" />
    <!-- Required to call startForeground() from KuwagoVpnService -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Required on Android 14+ for foreground services with type=specialUse -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/kuwago"
        android:label="@string/app_name"
        android:roundIcon="@drawable/kuwago"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.Mykotlinapp">
        <activity
            android:name=".MainActivity"
            android:theme="@style/Theme.App.SplashScreen"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".WarningOverlayActivity"
            android:exported="false"
            android:theme="@style/Theme.Mykotlinapp" />

        <receiver
            android:name=".SmsReceiver"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter android:priority="999">
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".SmsNotificationListener"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!--
            KuwagoVpnService — DNS-proxy VPN that enforces previously-established
            SMISHING decisions from Kuwago's scanner without inspecting content.

            android:foregroundServiceType="specialUse" is required on Android 14+
            (API 34) when the service type does not fit one of the predefined types.
            VpnService manages its own ongoing notification via the system VPN
            notification, but we also call startForeground() for lifecycle safety.
        -->
        <service
            android:name=".KuwagoVpnService"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:foregroundServiceType="specialUse"
            android:exported="false">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>

        <!-- VPN block warning — shown from a notification when a connection is blocked -->
        <activity
            android:name=".VpnBlockedActivity"
            android:exported="false"
            android:theme="@style/Theme.Mykotlinapp"
            android:taskAffinity=""
            android:excludeFromRecents="true" />

    </application>

</manifest>