<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A0000"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center">

    <!-- Warning Icon -->
    <ImageView
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:src="@drawable/ic_block"
        app:tint="@color/color_alert"
        android:contentDescription="Warning Icon" />

    <!-- Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:fontFamily="sans-serif-black"
        android:text="⚠️ UNHANDLED SMISHING ALERT"
        android:textColor="@color/color_alert"
        android:textSize="22sp"
        android:gravity="center" />

    <!-- Description -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:text="High-risk smishing messages were detected in your SMS inbox from a sender that is NOT blacklisted yet."
        android:textColor="#E0E0E0"
        android:textSize="14sp" />

    <!-- Threat Details Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_action_card"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/warning_sender"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-bold"
                android:text="Sender: BDO"
                android:textColor="@color/text_primary"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/warning_confidence"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_status_badge"
                android:backgroundTint="@color/color_alert"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="96.5% Threat"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:fontFamily="sans-serif-black" />
        </LinearLayout>

        <TextView
            android:id="@+id/warning_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:ellipsize="end"
            android:maxLines="3"
            android:text="Your account has been restricted. Click here to verify."
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:fontStyle="italic" />
    </LinearLayout>

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:orientation="vertical">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_add_blacklist_now"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_status_badge"
            android:backgroundTint="@color/color_alert"
            android:fontFamily="sans-serif-bold"
            android:text="🔒 Blacklist &amp; Suppress Notifications"
            android:textColor="@color/white"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/btn_proceed_anyway"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="16dp"
            android:padding="8dp"
            android:text="Ignore &amp; Proceed to SMS App"
            android:textColor="#A0A0A0"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

</LinearLayout>
