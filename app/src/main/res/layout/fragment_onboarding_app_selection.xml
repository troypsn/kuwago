<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="30dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/sf_pro"
        android:text="@string/onboarding_apps_title"
        android:textColor="@color/text_primary"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/sf_pro"
        android:lineSpacingExtra="4dp"
        android:text="@string/onboarding_apps_body"
        android:textColor="@color/text_secondary"
        android:textSize="15sp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="16dp"
        android:layout_weight="1">

        <!-- Animated Loading State -->
        <LinearLayout
            android:id="@+id/layout_apps_loading"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <ProgressBar
                android:id="@+id/progress_loading_apps"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:indeterminateTint="@color/white" />

            <TextView
                android:id="@+id/tv_loading_apps_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/sf_pro"
                android:text="Finding messaging apps…"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Empty state fallback if none found -->
        <TextView
            android:id="@+id/tv_onboarding_no_apps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="@font/sf_pro"
            android:gravity="center"
            android:text="@string/no_apps_found"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:visibility="gone" />

        <!-- Loaded Applications List -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_onboarding_apps"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0"
            android:clipToPadding="false"
            android:paddingBottom="8dp"
            android:visibility="gone" />

    </FrameLayout>

    <Button
        android:id="@+id/btn_onboarding_finish"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/bg_onboarding_primary"
        android:fontFamily="@font/sf_pro"
        android:text="@string/onboarding_finish"
        android:textAllCaps="false"
        android:textColor="@color/black"
        android:textSize="16sp"
        android:textStyle="bold" />

</LinearLayout>
