<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_primary">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="0dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="sans-serif-black"
            android:text="@string/blacklist_title"
            android:textColor="@color/text_primary"
            android:textSize="28sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_block"
                android:alpha="0.5"
                android:contentDescription="blacklist icon" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/blacklist_subtitle"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

    </LinearLayout>

    <!-- Search + Filter row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="16dp"
        android:gravity="center_vertical">

        <!-- Search bar -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/bg_action_card"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_search"
                android:alpha="0.4"
                android:contentDescription="search" />

            <EditText
                android:id="@+id/blacklist_search"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:background="@null"
                android:hint="Search senders…"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="14sp"
                android:singleLine="true"
                android:imeOptions="actionSearch"
                android:inputType="text" />
        </LinearLayout>

        <!-- Filter button -->
        <ImageView
            android:id="@+id/btn_filter"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="10dp"
            android:src="@drawable/ic_filter"
            android:padding="12dp"
            android:background="@drawable/bg_action_card"
            android:contentDescription="filter"
            android:clickable="true"
            android:focusable="true"
            android:alpha="0.8" />
    </LinearLayout>

    <!-- Filter chips (hidden by default, shown when filter button tapped) -->
    <HorizontalScrollView
        android:id="@+id/filter_chip_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="10dp"
        android:visibility="gone"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/filter_chip_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Chip: All -->
            <TextView
                android:id="@+id/chip_all"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="8dp"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="All"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium"
                android:background="@drawable/bg_chip_selected"
                android:textColor="@color/text_primary"
                android:clickable="true"
                android:focusable="true" />

            <!-- Chip: High Risk -->
            <TextView
                android:id="@+id/chip_high_risk"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="8dp"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="High Risk"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium"
                android:background="@drawable/bg_chip_unselected"
                android:textColor="@color/text_secondary"
                android:clickable="true"
                android:focusable="true" />

            <!-- Chip: Medium Risk -->
            <TextView
                android:id="@+id/chip_medium_risk"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="8dp"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="Medium Risk"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium"
                android:background="@drawable/bg_chip_unselected"
                android:textColor="@color/text_secondary"
                android:clickable="true"
                android:focusable="true" />

            <!-- Chip: Unknown Sender -->
            <TextView
                android:id="@+id/chip_unknown"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="8dp"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="Unknown Sender"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium"
                android:background="@drawable/bg_chip_unselected"
                android:textColor="@color/text_secondary"
                android:clickable="true"
                android:focusable="true" />

            <!-- Chip: Auto-blacklisted -->
            <TextView
                android:id="@+id/chip_auto"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="8dp"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="Auto-blacklisted"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium"
                android:background="@drawable/bg_chip_unselected"
                android:textColor="@color/text_secondary"
                android:clickable="true"
                android:focusable="true" />

            <!-- Chip: Manually Added -->
            <TextView
                android:id="@+id/chip_manual"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="8dp"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="Manually Added"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium"
                android:background="@drawable/bg_chip_unselected"
                android:textColor="@color/text_secondary"
                android:clickable="true"
                android:focusable="true" />

            <!-- Chip: Risk ↑ (high to low) -->
            <TextView
                android:id="@+id/chip_sort_high_low"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="8dp"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="Risk ↑"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium"
                android:background="@drawable/bg_chip_unselected"
                android:textColor="@color/text_secondary"
                android:clickable="true"
                android:focusable="true" />

            <!-- Chip: Risk ↓ (low to high) -->
            <TextView
                android:id="@+id/chip_sort_low_high"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="8dp"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="Risk ↓"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium"
                android:background="@drawable/bg_chip_unselected"
                android:textColor="@color/text_secondary"
                android:clickable="true"
                android:focusable="true" />

            <!-- Chip: Newest -->
            <TextView
                android:id="@+id/chip_sort_newest"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="8dp"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="Newest"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium"
                android:background="@drawable/bg_chip_unselected"
                android:textColor="@color/text_secondary"
                android:clickable="true"
                android:focusable="true" />

            <!-- Chip: Oldest -->
            <TextView
                android:id="@+id/chip_sort_oldest"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="8dp"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="Oldest"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium"
                android:background="@drawable/bg_chip_unselected"
                android:textColor="@color/text_secondary"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>
    </HorizontalScrollView>

    <!-- List -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/blacklist_recycler_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="80dp"
            android:visibility="visible" />

        <!-- Empty state -->
        <LinearLayout
            android:id="@+id/blacklist_empty_state"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="20dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/ic_block"
                app:tint="@color/text_secondary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="sans-serif-bold"
                android:text="No Blacklisted Senders"
                android:textColor="@color/text_primary"
                android:textSize="16sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="Senders blocked automatically or manually will appear here."
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />
        </LinearLayout>
    </FrameLayout>

</LinearLayout>
