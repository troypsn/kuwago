<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_primary">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="0dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/sf_pro"
            android:textStyle="bold"
            android:text="@string/message_history_title"
            android:textColor="@color/text_primary"
            android:textSize="28sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_history"
                android:alpha="0.5"
                android:contentDescription="history icon" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/detections_history_title"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

    </LinearLayout>

    <!-- Search + Filter row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="16dp"
        android:gravity="center_vertical">

        <!-- Search bar -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/bg_action_card"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_search"
                android:alpha="0.4"
                android:contentDescription="search" />

            <EditText
                android:id="@+id/history_search"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:background="@null"
                android:hint="Search messages…"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="14sp"
                android:singleLine="true"
                android:imeOptions="actionSearch"
                android:inputType="text" />
        </LinearLayout>

        <!-- Filter button -->
        <ImageView
            android:id="@+id/history_btn_filter"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="10dp"
            android:src="@drawable/ic_filter"
            android:padding="12dp"
            android:background="@drawable/bg_action_card"
            android:contentDescription="filter"
            android:clickable="true"
            android:focusable="true"
            android:alpha="0.8" />
    </LinearLayout>

    <!-- Filter chips -->
    <HorizontalScrollView
        android:id="@+id/history_filter_chip_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="10dp"
        android:visibility="gone"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/history_filter_chip_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Chip: All -->
            <TextView
                android:id="@+id/history_chip_all"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="8dp"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="All"
                android:textSize="12sp"
                android:fontFamily="@font/sf_pro"
                android:background="@drawable/bg_chip_selected"
                android:textColor="@color/text_primary"
                android:clickable="true"
                android:focusable="true" />

            <!-- Chip: Harmful -->
            <TextView
                android:id="@+id/history_chip_harmful"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="8dp"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="Harmful"
                android:textSize="12sp"
                android:fontFamily="@font/sf_pro"
                android:background="@drawable/bg_chip_unselected"
                android:textColor="@color/text_secondary"
                android:clickable="true"
                android:focusable="true" />

            <!-- Chip: Suspicious -->
            <TextView
                android:id="@+id/history_chip_suspicious"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="8dp"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="Suspicious"
                android:textSize="12sp"
                android:fontFamily="@font/sf_pro"
                android:background="@drawable/bg_chip_unselected"
                android:textColor="@color/text_secondary"
                android:clickable="true"
                android:focusable="true" />

            <!-- Chip: Safe -->
            <TextView
                android:id="@+id/history_chip_safe"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="8dp"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="Safe"
                android:textSize="12sp"
                android:fontFamily="@font/sf_pro"
                android:background="@drawable/bg_chip_unselected"
                android:textColor="@color/text_secondary"
                android:clickable="true"
                android:focusable="true" />

            <!-- Chip: Newest -->
            <TextView
                android:id="@+id/history_chip_newest"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="8dp"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="Newest"
                android:textSize="12sp"
                android:fontFamily="@font/sf_pro"
                android:background="@drawable/bg_chip_unselected"
                android:textColor="@color/text_secondary"
                android:clickable="true"
                android:focusable="true" />

            <!-- Chip: Oldest -->
            <TextView
                android:id="@+id/history_chip_oldest"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="8dp"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="Oldest"
                android:textSize="12sp"
                android:fontFamily="@font/sf_pro"
                android:background="@drawable/bg_chip_unselected"
                android:textColor="@color/text_secondary"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>
    </HorizontalScrollView>

    <!-- SMS Permission Toggle Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_action_card"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/sf_pro"
                android:textStyle="bold"
                android:text="SMS Inbox Integration"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tv_permission_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Grant permission to analyze device SMS history"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switch_sms_permission"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            app:thumbTint="@color/white"
            app:trackTint="@color/text_secondary" />
    </LinearLayout>

    <!-- "Detections History" sub-heading + refresh -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:fontFamily="@font/sf_pro"
            android:textStyle="bold"
            android:text="@string/detections_history_title"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

        <ImageView
            android:id="@+id/btn_refresh_history"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:padding="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_history"
            android:contentDescription="Refresh history"
            app:tint="@color/text_secondary" />
    </RelativeLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- RecyclerView for dynamic SMS loading -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/history_recycler_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="80dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:visibility="gone" />

        <!-- Empty / Permission Required state view -->
        <LinearLayout
            android:id="@+id/layout_empty_state"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="20dp"
            android:visibility="visible">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/ic_history"
                app:tint="@color/text_secondary" />

            <TextView
                android:id="@+id/tv_empty_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/sf_pro"
                android:textStyle="bold"
                android:text="SMS Access Required"
                android:textColor="@color/text_primary"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tv_empty_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="Turn on SMS Inbox Integration above to read, analyze, and display your SMS inbox messages locally."
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />
        </LinearLayout>
    </FrameLayout>

</LinearLayout>
